datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CategoriaInversion {
  ACTIVO_FIJO
  INSUMO
  SERVICIO
  APORTE_CAPITAL
}

enum EstadoVenta {
  PENDIENTE
  EN_PRODUCCION
  ENTREGADO
  CANCELADO
}

enum TipoPrecio {
  AMIGOS
  MERCADO
  COMUNIDAD
  PERSONALIZADO
}

model Inversion {
  id                  String             @id @default(uuid())
  persona             String             @default("Víctor")
  categoria           CategoriaInversion
  subcategoria        String?
  itemConcepto        String
  especificacionColor String?
  presentacion        String?
  cantidad            Int                @default(1)
  costoUnitario       Decimal            @db.Decimal(10, 2)
  costoEnvio          Decimal?           @default(0.00) @db.Decimal(10, 2)
  costoTotal          Decimal            @db.Decimal(10, 2)
  costoPorGramo       Decimal?           @db.Decimal(10, 4)
  numeroCuotas        Int?
  montoCuota          Decimal?           @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Categoria {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TagInsumo {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  color       String?  @default("amber") // blue, emerald, purple, amber, pink, indigo
  categoria   String?  @default("INSUMO") // INSUMO, ACTIVO_FIJO, SERVICIO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventarioFilamento {
  id                      String   @id @default(uuid())
  nombreColor             String
  codigoHex               String?  @default("#1E1E1E")
  tipoMaterial            String   @default("PLA") // PLA, PLA Matte, PLA+, PETG, TPU, ABS, Resina
  marca                   String?  @default("Genérica")
  formato                 String?  @default("CON_BOBINA") // CON_BOBINA (Con Bobina Reutilizable BR), REFILL (Refill sin bobina)
  estadoStock             String   @default("ABIERTO") // ABIERTO (En Uso), SELLADO (Cajas Selladas / Reserva), FALTANTE (Por Reponer)
  numeroBobina            Int?     @default(1) // Ej: Bobina #1, Bobina #2 para instancias independientes
  porcentajeRestante      Decimal? @default(100.0) @db.Decimal(5, 2) // % restante estimado
  stockBobinas            Decimal  @default(1.0) @db.Decimal(10, 2)
  stockGramos             Decimal? @default(1000.0) @db.Decimal(10, 2)
  pesoInicialGramos       Decimal? @default(1000.0) @db.Decimal(10, 2)
  cajasSelladasDisponibles Int?    @default(1) // Conteo de cajas selladas en reserva
  cantidadCompradaRef     Decimal? @default(1.0) @db.Decimal(10, 2)
  costoBobinaRef          Decimal? @default(0.00) @db.Decimal(10, 2)
  ubicacion               String?  @default("Taller Principal")
  temperaturaImpresion    String?
  temperaturaCama         String?
  estado                  String   @default("DISPONIBLE") // DISPONIBLE, BAJO_STOCK, AGOTADO
  alertaCritica           Boolean  @default(false)
  notaProduccion          String?
  notas                   String?
  activo                  Boolean  @default(true)
  ventas                  Venta[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ConsumibleTaller {
  id        String   @id @default(uuid())
  nombre    String   @unique
  categoria String   @default("POSTPROCESADO") // POSTPROCESADO, SEGURIDAD, ADHESION, HERRAMIENTA
  estado    String   @default("DISPONIBLE") // DISPONIBLE, BAJO_STOCK, AGOTADO
  cantidad  String?  @default("1 ud")
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Producto {
  id               String   @id @default(uuid())
  lineaCategoria   String
  nombreModelo     String   @unique
  costoBase        Decimal  @db.Decimal(10, 2)
  precioAmigos     Decimal  @db.Decimal(10, 2)
  precioMercado    Decimal  @db.Decimal(10, 2)
  precioComunidad  Decimal  @db.Decimal(10, 2)
  pesoGramos       Decimal? @default(0.00) @db.Decimal(10, 2)
  activo           Boolean  @default(true)
  ventas           Venta[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Venta {
  id                     String               @id @default(uuid())
  fecha                  DateTime             @default(now())
  cliente                String
  productoId             String
  producto               Producto             @relation(fields: [productoId], references: [id])
  nombreProductoSnapshot String?
  costoBaseSnapshot      Decimal?             @default(0.00) @db.Decimal(10, 2)
  colorFilamentoId       String?
  colorFilamento         InventarioFilamento? @relation(fields: [colorFilamentoId], references: [id])
  personalizacion        String?
  gramosConsumidos       Decimal?             @default(0.00) @db.Decimal(10, 2) // Gramos descontados de la bobina
  cantidad               Int                  @default(1)
  tipoPrecio             TipoPrecio           @default(COMUNIDAD)
  precioUnitario         Decimal              @db.Decimal(10, 2)
  total                  Decimal              @db.Decimal(10, 2)
  montoPagado            Decimal              @db.Decimal(10, 2)
  saldoPendiente         Decimal              @db.Decimal(10, 2)
  costoPackaging         Decimal?             @default(0.00) @db.Decimal(10, 2)
  porcentajeAdicional    Decimal?             @default(0.00) @db.Decimal(5, 2)
  estado                 EstadoVenta          @default(PENDIENTE)
  diaEntregaPrometida    String?
  destinoEnvio           String?
  canalVenta             String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model Ingreso {
  id          String   @id @default(uuid())
  fecha       DateTime @default(now())
  cliente     String
  concepto    String
  categoria   String   @default("SERVICIO") // VENTA_DIRECTA, SERVICIO, DISENO_CAD, OTRO
  monto       Decimal  @db.Decimal(10, 2)
  metodoPago  String?  @default("YAPE") // YAPE, PLIN, TRANSFERENCIA, EFECTIVO
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CierreMes {
  id                       String   @id @default(uuid())
  mes                      Int      // 1-12 (ej. 8 para Agosto)
  anio                     Int      // ej. 2026
  nombrePeriodo            String   // "Agosto 2026"
  fechaCierre              DateTime @default(now())
  
  // Métricas del Mes
  totalIngresosVentas      Decimal  @db.Decimal(10, 2)
  totalIngresosDirectos    Decimal  @db.Decimal(10, 2)
  totalIngresos            Decimal  @db.Decimal(10, 2)
  
  totalEgresosInsumos      Decimal  @db.Decimal(10, 2)
  totalEgresosMaquinaria   Decimal  @db.Decimal(10, 2)
  totalEgresosServicios    Decimal  @db.Decimal(10, 2)
  totalEgresos             Decimal  @db.Decimal(10, 2)
  
  flujoNetoMes             Decimal  @db.Decimal(10, 2)
  
  // Arqueo y Conciliación
  saldoSistema             Decimal  @db.Decimal(10, 2)
  saldoRealBCP             Decimal  @default(0.00) @db.Decimal(10, 2)
  saldoRealYape            Decimal  @default(0.00) @db.Decimal(10, 2)
  saldoRealTotal           Decimal  @db.Decimal(10, 2)
  descuadreCaja            Decimal  @default(0.00) @db.Decimal(10, 2)
  
  // Asignación y Blindaje de Fondos
  montoCuotaPrestamo       Decimal  @default(0.00) @db.Decimal(10, 2)
  montoReservaMaquina      Decimal  @default(0.00) @db.Decimal(10, 2)
  montoColchonEmergencia   Decimal  @default(0.00) @db.Decimal(10, 2)
  totalFondosBlindados     Decimal  @db.Decimal(10, 2)
  liquidezLibreFinal       Decimal  @db.Decimal(10, 2)
  
  cuentasPorCobrarTraspaso Decimal  @default(0.00) @db.Decimal(10, 2)
  totalPedidosMes          Int      @default(0)
  
  notas                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

